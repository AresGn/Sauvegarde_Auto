<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Company>AutosavePro</Company>
    <Product>AutosavePro</Product>
    <Description>Application de sauvegarde automatique intelligente</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>autosave.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="autosave.ico" />
  </ItemGroup>

</Project>